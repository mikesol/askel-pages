---
import '../styles/globals.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Turun Suurpesula, teollisen mittakaavan tekstiilihuolto hotelleille, hoivakodeille ja vahinkosaneeraukseen Turussa.'
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, 'https://turunsuurpesula.fi')

const navLinks = [
  { href: '/', label: 'Etusivu' },
  { href: '/hotellit', label: 'Hotellit' },
  { href: '/vanhustenhoito', label: 'Hoiva- ja palvelutalot' },
  { href: '/hatapesut', label: 'Vahinkopesut' },
  { href: '/meista', label: 'Meistä' },
  { href: '/yhteys', label: 'Ota yhteyttä' },
]
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:site_name" content="Turun Suurpesula" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <slot name="head" />
  </head>
  <body class="min-h-full">
    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-40 md:hidden" style="display:none;" aria-hidden="true">
      <!-- Backdrop -->
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
      <!-- Drawer -->
      <div class="absolute top-0 right-0 bottom-0 w-72 bg-white flex flex-col shadow-2xl">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[#E9E4DF]">
          <img src="/tsp-logo-vector.svg" alt="Turun Suurpesula" class="h-10" />
          <button id="mobile-menu-close" aria-label="Sulje valikko" class="p-2 rounded-full hover:bg-[#F1F2F4] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#14375A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <nav class="flex flex-col px-4 py-6 gap-1 flex-1">
          {navLinks.map((l) => (
            <a href={l.href} class="font-sora font-medium text-[#14375A] text-base px-4 py-3.5 rounded-xl hover:bg-[#F1F2F4] transition-colors">{l.label}</a>
          ))}
        </nav>
        <div class="px-6 pb-8 flex flex-col gap-3">
          <a href="tel:0222321300" class="flex items-center justify-center gap-2 border-2 border-[#14375A] text-[#14375A] font-sora font-bold px-5 py-3 rounded-full text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.29 6.29l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            02 2321 300
          </a>
          <a href="/yhteys" class="flex items-center justify-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-5 py-3 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">Pyydä tarjous →</a>
        </div>
      </div>
    </div>

    <header id="site-header" class="sticky top-0 z-50 transition-all duration-300" style="background: #ffffff; backdrop-filter: none;">
      <div class="max-w-6xl mx-auto px-6 py-3 md:py-4 flex items-center justify-between gap-4">
        <a href="/" class="shrink-0">
          <img id="site-logo" src="/tsp-logo-vector.svg" alt="Turun Suurpesula" class="h-10 md:h-14" />
        </a>
        <nav class="hidden md:flex items-center gap-7">
          {navLinks.map((l) => (
            <a href={l.href} data-navlink class="font-sora text-sm transition-colors" style="color: rgba(20,55,90,0.7);">{l.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <a id="site-phone" href="tel:0222321300" class="hidden sm:block font-sora font-semibold text-sm transition-colors" style="color: #14375A;">02 2321 300</a>
          <a href="/yhteys" class="hidden md:inline-flex items-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-5 py-2.5 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">Pyydä tarjous →</a>
          <!-- Hamburger button — mobile only -->
          <button id="mobile-menu-open" aria-label="Avaa valikko" class="md:hidden p-2 rounded-full hover:bg-[#F1F2F4] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#14375A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <script>
      // Scroll blur
      (function () {
        var h = document.getElementById('site-header');
        function update() {
          var scrolled = window.scrollY > 40;
          h.style.background = scrolled ? 'rgba(255,255,255,0.6)' : '#ffffff';
          h.style.backdropFilter = scrolled ? 'blur(20px)' : 'none';
          h.style.webkitBackdropFilter = scrolled ? 'blur(20px)' : 'none';
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      // Mobile menu
      (function () {
        var menu = document.getElementById('mobile-menu');
        var openBtn = document.getElementById('mobile-menu-open');
        var closeBtn = document.getElementById('mobile-menu-close');
        var backdrop = document.getElementById('mobile-menu-backdrop');

        function open() {
          menu.style.display = 'block';
          menu.removeAttribute('aria-hidden');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          menu.style.display = 'none';
          menu.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        backdrop.addEventListener('click', close);

        // Close on nav link click
        menu.querySelectorAll('nav a').forEach(function(a) {
          a.addEventListener('click', close);
        });

        // Close on Escape
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>

    <slot />

    <!-- Sticky mobile CTA bar -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-white border-t border-[#E9E4DF] px-4 py-3 flex gap-3" style="padding-bottom: max(12px, env(safe-area-inset-bottom));">
      <a href="tel:0222321300" class="flex-1 flex items-center justify-center gap-2 border-2 border-[#14375A] text-[#14375A] font-sora font-bold px-4 py-3 rounded-full text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.29 6.29l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Soita
      </a>
      <a href="/yhteys" class="flex-1 flex items-center justify-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-4 py-3 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">
        Pyydä tarjous →
      </a>
    </div>

    <!-- Spacer so sticky CTA doesn't overlap page content on mobile -->
    <div class="md:hidden h-20"></div>

    <footer class="bg-[#14375A] text-white">
      <div class="max-w-6xl mx-auto px-6 py-14 grid md:grid-cols-3 gap-10">
        <div>
          <img src="/tsp-logo-vector.svg" alt="Turun Suurpesula" class="h-36 mb-3" style="filter: brightness(0) invert(1); opacity: 0.9" />
          <p class="font-inter text-white/50 text-sm leading-relaxed">Jo vuodesta 2010. Luotettava arjen kumppanisi.</p>
        </div>
        <div>
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Sivukartta</p>
          <ul class="flex flex-col gap-2">
            {navLinks.concat([{ href: '/yhteys', label: 'Yhteys' }]).map((l) => (
              <li><a href={l.href} class="font-inter text-white/60 hover:text-white transition-colors text-sm">{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Yhteystiedot</p>
          <ul class="flex flex-col gap-2 font-inter text-white/60 text-sm">
            <li>Telekatu 6, 20360 Turku</li>
            <li><a href="tel:0222321300" class="hover:text-white transition-colors">02 2321 300</a></li>
            <li><a href="mailto:myynti@melers.fi" class="hover:text-white transition-colors">myynti@melers.fi</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
          <p class="font-inter text-white/30 text-sm">© {new Date().getFullYear()} Turun Suurpesula. Kaikki oikeudet pidätetään.</p>
          <div class="flex items-center gap-4">
            <p class="font-inter text-white/20 text-xs">Turun Suurpesula on Melers Oy:n aputoiminimi. Y-tunnus 2531284-4.</p>
            <a href="/tietosuoja" class="font-inter text-white/30 text-xs hover:text-white/60 transition-colors whitespace-nowrap">Tietosuoja</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('form[data-contact-form]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault()
          const button = form.querySelector('button[type="submit"]')
          const status = form.querySelector('[data-form-status]')
          const label = button.textContent
          button.disabled = true
          button.textContent = 'Lähetetään...'
          status.textContent = ''

          const data = { source: window.location.pathname }
          new FormData(form).forEach((v, k) => { data[k] = v })

          try {
            const r = await fetch('/api/form', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            })
            if (!r.ok) throw new Error()
            form.reset()
            status.className = 'font-inter text-xs text-center mt-1 text-[#14375A]'
            status.textContent = 'Kiitos! Viesti lähetetty, palataan teille 24 tunnissa.'
          } catch {
            status.className = 'font-inter text-xs text-center mt-1 text-red-500'
            status.textContent = 'Lähetys epäonnistui. Soita 02 2321 300 tai myynti@melers.fi.'
          } finally {
            button.disabled = false
            button.textContent = label
          }
        })
      })
    </script>
  </body>
</html>
