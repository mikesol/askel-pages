---
import '../styles/globals.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Turun Suurpesula, teollisen mittakaavan tekstiilihuolto hotelleille, hoivakodeille ja vahinkosaneeraukseen Turussa.'
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, 'https://turunsuurpesula.fi')

const navLinks = [
  { href: '/', label: 'Etusivu' },
  { href: '/hotellit', label: 'Hotellit' },
  { href: '/vanhustenhoito', label: 'Vanhustenhoito' },
  { href: '/hatapesut', label: 'Hätäpesut' },
  { href: '/meista', label: 'Meistä' },
]
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:site_name" content="Turun Suurpesula" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&family=Sora:wght@400;500;600;700&family=Inter:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <slot name="head" />
  </head>
  <body class="min-h-full">
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-[#E9E4DF]">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        <a href="/" class="font-sora font-bold text-[#14375A] text-lg shrink-0">Turun Suurpesula</a>
        <nav class="hidden md:flex items-center gap-7">
          {navLinks.map((l) => (
            <a href={l.href} class="font-sora text-sm text-[#14375A]/70 hover:text-[#14375A] transition-colors">{l.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-4">
          <a href="tel:0222321300" class="hidden sm:block font-sora font-semibold text-sm text-[#14375A]">02 2321 300</a>
          <a href="/yhteys" class="inline-flex items-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-5 py-2.5 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">Pyydä tarjous →</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="bg-[#14375A] text-white">
      <div class="max-w-6xl mx-auto px-6 py-14 grid md:grid-cols-3 gap-10">
        <div>
          <img src="/melers-logo-white.png" alt="Melers" class="h-12 mb-3 opacity-80" />
          <p class="font-sora font-bold text-lg mb-3">Turun Suurpesula</p>
          <p class="font-inter text-white/50 text-sm leading-relaxed">Kahdenkymmenen vuoden kokemuksella. Luotettava arjen kumppanisi.</p>
        </div>
        <div>
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Sivukartta</p>
          <ul class="flex flex-col gap-2">
            {navLinks.concat([{ href: '/yhteys', label: 'Yhteys' }]).map((l) => (
              <li><a href={l.href} class="font-inter text-white/60 hover:text-white transition-colors text-sm">{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Yhteystiedot</p>
          <ul class="flex flex-col gap-2 font-inter text-white/60 text-sm">
            <li>Telekatu 6, 20360 Turku</li>
            <li><a href="tel:0222321300" class="hover:text-white transition-colors">02 2321 300</a></li>
            <li><a href="mailto:myynti@melers.fi" class="hover:text-white transition-colors">myynti@melers.fi</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
          <p class="font-inter text-white/30 text-sm">© {new Date().getFullYear()} Turun Suurpesula. Kaikki oikeudet pidätetään.</p>
          <p class="font-inter text-white/20 text-xs">Turun Suurpesula on Melers Oy:n aputoiminimi. Y-tunnus 2531284-4.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
