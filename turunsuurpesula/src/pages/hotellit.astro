---
import Layout from '../layouts/Layout.astro'

const benefits = [
  { title: 'Joustava kapasiteetti', desc: 'Skaalaamme palvelun ylös sesonkihuippuina ja alas hiljaisempina kuukausina — maksatte tarpeenne mukaan, ette kiinteän minimin mukaan.' },
  { title: 'Liinavaatevuokraus, jos sitä tarvitsette', desc: 'Ei pakkoa omistaa liinavaatteita. Halutessanne vuokraamme lakanat ja pyyhkeet osana sopimusta — ei pääomaa kiinni varastossa.' },
  { title: 'Oma palvelupäällikkö', desc: 'Nimetty yhteyshenkilö, joka tuntee hotellinne rytmin ja tarpeet — ei vaihtuvaa asiakaspalvelunumeroa, vaan yksi ihminen jolle soittaa.' },
  { title: 'Kilpailukykyinen hinnoittelu', desc: 'Läpinäkyvä tarjous ilman piilokuluja — pyydä vertailu nykyiseen sopimukseenne.' },
]

const steps = [
  { num: '1', title: 'Kartoitus', desc: 'Palvelupäällikkönne käy läpi huonemäärän, käyttöasteen vaihtelut ja sen, vuokraatteko liinavaatteet meiltä vai käytätte omianne.' },
  { num: '2', title: 'Räätälöity tarjous', desc: 'Saatte sopimuksen, jossa nouto- ja toimitusrytmi sekä kapasiteetin jousto on mitoitettu juuri teidän sesonkeihinne.' },
  { num: '3', title: 'Käyttöönotto', desc: 'Palvelu käynnistyy sovitulla aikataululla, jopa 2 arkipäivässä sopimuksen allekirjoituksesta.' },
  { num: '4', title: 'Jatkuva palvelu', desc: 'Nouto ja toimitus sovitulla rytmillä, palvelupäällikkönne tavoitettavissa aina 2h sisällä.' },
]
---
<Layout title="Hotellit | Turun Suurpesula" description="Joustava pesupalvelu hotelleille Turussa — skaalautuva kapasiteetti, liinavaatevuokraus ja oma palvelupäällikkö. Tarjous 24 tunnissa.">

  <section class="bg-[#14375A] overflow-hidden">
    <div class="w-full grid md:grid-cols-[55%_45%] min-h-[420px]">
      <div class="flex items-center px-8 md:px-16 py-20">
        <div class="max-w-lg">
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-6">Yrityksille · Hotellit</p>
          <h1 class="font-merriweather font-normal text-white text-4xl md:text-5xl leading-snug mb-6">Joustava pesupalvelu, joka mukautuu <span class="text-[#FF8F7A]">sesonkiinne.</span></h1>
          <p class="font-inter text-white/65 text-base leading-relaxed mb-10">Kesän täyskäyttö tai hiljainen tammikuu — kapasiteettimme skaalautuu hotellinne tarpeen mukaan. Ei kiinteitä minimimääriä, ei ylimääräistä sitoutumista silloin kun kysyntä vaihtelee.</p>
          <a href="/yhteys" class="inline-flex items-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-7 py-3.5 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">Pyydä tarjous →</a>
        </div>
      </div>
      <div class="hidden md:block relative">
        <img src="/photo-hotel.webp" alt="Puhtaita liinavaatteita hotelleille" class="absolute inset-0 w-full h-full object-cover object-center" />
        <div class="absolute inset-0" style="background: linear-gradient(to right, #14375A 0%, #14375A 5%, transparent 40%)"></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-12 text-center">
        <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Miksi hotellit valitsevat meidät</p>
        <h2 class="font-merriweather font-normal text-[#14375A] text-3xl md:text-4xl">Palvelu, joka ei jätä pinteeseen</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {benefits.map((b) => (
          <div class="bg-[#F1F2F4] rounded-2xl p-7">
            <div class="font-sora font-bold text-[#14375A] text-base mb-2">{b.title}</div>
            <div class="font-inter text-[#14375A]/60 text-sm leading-relaxed">{b.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#F1F2F4] py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-12 text-center">
        <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Miten palvelu toimii</p>
        <h2 class="font-merriweather font-normal text-[#14375A] text-3xl md:text-4xl">Neljä askelta puhtaaseen ratkaisuun</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {steps.map((s) => (
          <div class="bg-white rounded-2xl p-7 flex flex-col">
            <div class="font-merriweather font-normal text-6xl text-[#FF8F7A]/20 leading-none mb-4">{s.num}</div>
            <div class="font-sora font-semibold text-[#14375A] text-base mb-3">{s.title}</div>
            <div class="font-inter text-[#14375A]/60 text-sm leading-relaxed">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#FF8F7A] py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">

        <div class="flex flex-col justify-center h-full gap-6 md:py-8">
          <h2 class="font-merriweather font-normal text-white text-3xl md:text-4xl leading-snug">Palvelu joka joustaa teidän sesonkinne mukaan.</h2>
          <p class="font-inter text-white/80 text-base leading-relaxed">Pyydä tarjous ja tapaa oma palvelujohtajanne.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/yhteys" class="inline-flex items-center justify-center gap-2 bg-white text-[#14375A] font-sora font-bold px-7 py-3.5 rounded-full hover:bg-white/90 transition-colors text-sm">Pyydä tarjous →</a>
            <a href="tel:0222321300" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-sora font-bold px-7 py-3.5 rounded-full hover:bg-white/10 transition-colors text-sm">Soita 02 2321 300</a>
          </div>
        </div>

        <div class="bg-white rounded-3xl overflow-hidden">
          <div class="px-8 pt-7 pb-3">
            <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-1">Varaa tapaaminen</p>
            <p class="font-inter text-[#14375A]/60 text-sm">Valitse sinulle sopiva aika suoraan kalenterista.</p>
          </div>
          <iframe
            src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ14fXOqowBDfPHNey_5OQgSrmRjQjYI84HGqepJbs9BCIpRU9rp9u7PZ50LSc3TnnHgUshxJJQD?gv=true"
            style="width: 100%; height: 500px; border: none"
            title="Varaa tapaaminen"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

</Layout>
