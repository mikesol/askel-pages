---
import Layout from '../layouts/Layout.astro'

const benefits = [
  { title: 'Nopea liinojen kierto', desc: 'Lakanat ja pyyhkeet takaisin käytössä ajoissa — sovitun aikataulun mukaan, ei häiriöitä huonepalvelulle.' },
  { title: 'Liinavaatevuokraus', desc: 'Ei omaa hankintaa eikä varastointia. Vuokraamme liinavaatteet ja pyyhkeet pitkäaikaissopimuksella.' },
  { title: 'Volyymipohjainen hinnoittelu', desc: 'Mitä enemmän, sitä edullisemmin per kg. Tarjous räätälöidään huoneiden käyttöasteen mukaan.' },
  { title: 'Tahranpoisto ammattimaisesti', desc: 'Vaativatkin tahrat käsitellään ammattimaisesti — ei hylättyjä liinoja tai pyyhkeitä.' },
]

const steps = [
  { num: '1', title: 'Ota yhteyttä', desc: 'Kerro huonemäärä ja käyttöaste — lähetämme tarjouksen 24 tunnissa.' },
  { num: '2', title: 'Sovitaan aikataulu', desc: 'Räätälöimme noudot ja toimitukset hotellinne rytmiin.' },
  { num: '3', title: 'Me hoidamme loput', desc: 'Tekstiilit noudetaan, pestään ja toimitetaan ajallaan takaisin.' },
]

const faqs = [
  { q: 'Kuinka nopeasti liinat kiertävät takaisin?', a: 'Sovitun aikataulun mukaan — tyypillisesti 24–48 tunnissa noudosta. Kiireapu järjestyy tarvittaessa.' },
  { q: 'Voimmeko vuokrata liinavaatteet kokonaan teiltä?', a: 'Kyllä. Pitkäaikaisasiakkaille tarjoamme liinavaatteiden ja pyyhkeiden vuokrauksen — ei omaa hankintaa, ei varastointia.' },
  { q: 'Miten hinnoittelu toimii vaihtelevalla käyttöasteella?', a: 'Volyymipohjaisesti — maksatte pestyn määrän mukaan. Sopimus joustaa sesonkien mukana.' },
]
---
<Layout title="Hotellit — Turun Suurpesula" description="Nopea liinojen kierto ja liinavaatevuokraus hotelleille Turussa. Volyymipohjainen hinnoittelu, tarjous 24 tunnissa.">

  <section class="bg-[#14375A] overflow-hidden">
    <div class="w-full grid md:grid-cols-[55%_45%] min-h-[420px]">
      <div class="flex items-center px-8 md:px-16 py-20">
        <div class="max-w-lg">
          <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-6">Yrityksille · Hotellit</p>
          <h1 class="font-merriweather font-normal text-white text-4xl md:text-5xl leading-snug mb-6">Puhtaat liinat, ajallaan — <span class="text-[#FF8F7A]">joka kerta.</span></h1>
          <p class="font-inter text-white/65 text-base leading-relaxed mb-10">Teollinen pesukapasiteetti tarkoittaa, että lakanat ja pyyhkeet ovat aina saatavilla — myös sesonkihuippuina.</p>
          <a href="/yhteys" class="inline-flex items-center gap-2 bg-[#FF8F7A] text-white font-sora font-bold px-7 py-3.5 rounded-full hover:bg-[#ff7a63] transition-colors text-sm">Pyydä tarjous →</a>
        </div>
      </div>
      <div class="hidden md:block relative">
        <img src="/photo-hotel.webp" alt="Puhtaita liinavaatteita hotelleille" class="absolute inset-0 w-full h-full object-cover object-center" />
        <div class="absolute inset-0" style="background: linear-gradient(to right, #14375A 0%, #14375A 5%, transparent 40%)"></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-6">
        {benefits.map((b) => (
          <div class="bg-[#F1F2F4] rounded-2xl p-7">
            <div class="font-sora font-bold text-[#14375A] text-base mb-2">{b.title}</div>
            <div class="font-inter text-[#14375A]/60 text-sm leading-relaxed">{b.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#F1F2F4] py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12 text-center">
        <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Prosessi</p>
        <h2 class="font-merriweather font-normal text-[#14375A] text-3xl md:text-4xl">Kolme askelta puhtaaseen ratkaisuun</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {steps.map((s) => (
          <div class="bg-white rounded-2xl p-7">
            <div class="font-merriweather font-normal text-6xl text-[#FF8F7A]/20 leading-none mb-4">{s.num}</div>
            <div class="font-sora font-semibold text-[#14375A] text-lg mb-3">{s.title}</div>
            <div class="font-inter text-[#14375A]/60 text-sm leading-relaxed">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-12 text-center">
        <p class="font-sora text-xs font-bold tracking-widest text-[#FF8F7A] uppercase mb-4">Usein kysyttyä</p>
        <h2 class="font-merriweather font-normal text-[#14375A] text-3xl">Kysymyksiä ja vastauksia</h2>
      </div>
      <div class="flex flex-col divide-y divide-[#E9E4DF]">
        {faqs.map((f) => (
          <div class="py-6">
            <div class="font-sora font-bold text-[#14375A] text-base mb-2">{f.q}</div>
            <div class="font-inter text-[#14375A]/65 text-sm leading-relaxed">{f.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#FF8F7A] py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-merriweather font-normal text-white text-3xl md:text-4xl leading-snug mb-8">Pyydä tarjous hotellinne tekstiilihuollolle</h2>
      <a href="/yhteys" class="inline-flex items-center gap-2 bg-white text-[#14375A] font-sora font-bold px-8 py-4 rounded-full hover:bg-white/90 transition-colors text-sm">Ota yhteyttä →</a>
    </div>
  </section>

</Layout>
